{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "autoreview provider review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "overall_explanation",
    "overall_confidence"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "overall_explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000,
      "pattern": "\\S"
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "priority",
        "confidence",
        "category",
        "location"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "priority": {
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "category": {
          "enum": [
            "bug",
            "security",
            "regression",
            "test_gap",
            "maintainability"
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_path", "start_line", "end_line"],
          "properties": {
            "file_path": {
              "type": "string",
              "minLength": 1
            },
            "start_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "end_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      }
    }
  }
}
